# Backend Environment Variables
# Copy this file to .env and fill in your values

# Database Configuration (Neon Serverless Postgres)
DATABASE_URL=postgresql://user:password@host/database

# Auth Server URL (for token validation)
# Local: http://localhost:3001
# Production: https://hackathon-i-physical-ai-robotics-textbook-production.up.railway.app
AUTH_SERVER_URL=http://localhost:3001

# Qdrant Vector Store
QDRANT_URL=https://your-cluster.qdrant.io
QDRANT_API_KEY=your-qdrant-api-key

# OpenAI API (for embeddings)
OPENAI_API_KEY=sk-your-openai-api-key

# Google Gemini API (for chat, personalize, translate)
GEMINI_API_KEY=your-gemini-api-key

# JWT Secret Key (generate: openssl rand -hex 32)
JWT_SECRET_KEY=your-secret-key-here
